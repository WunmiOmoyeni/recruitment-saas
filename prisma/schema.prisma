// Multi-tenant modular recruitment SaaS
// Auth + tenancy tables (User, Session, Account, Verification, Organization,
// Member, Invitation) follow Better Auth's schema with its organization plugin.
// Rule: every tenant-owned table carries organizationId.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled connection (app)
  directUrl = env("DIRECT_URL")   // direct connection (migrations)
}

// ───────────── Better Auth: users and sessions ─────────────

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions    Session[]
  accounts    Account[]
  members     Member[]
  invitations Invitation[]
  stageMoves  StageHistory[]

  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  activeOrganizationId String? // which organization this session is working in

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String? // hashed by Better Auth, never plain text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ───────────── Better Auth: organizations (tenants) ─────────────

model Organization {
  id        String   @id
  name      String
  slug      String?  @unique // used in public URLs: /apply/<slug>
  logo      String?
  createdAt DateTime @default(now())
  metadata  String?

  members     Member[]
  invitations Invitation[]
  modules     OrganizationModule[]
  jobs        Job[]
  stages      PipelineStage[]
  applicants  Applicant[]
  history     StageHistory[]
  emails      EmailLog[]

  @@map("organization")
}

// role is a string: "owner" | "admin" | "member" for now
model Member {
  id             String   @id
  organizationId String
  userId         String
  role           String   @default("member")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String   @id
  organizationId String
  email          String
  role           String?
  status         String   @default("pending")
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  inviterId      String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("invitation")
}

// ───────────── Modules (what a client has bought) ─────────────

model Module {
  key         String  @id
  name        String
  description String?

  organizations OrganizationModule[]
}

model OrganizationModule {
  id             String    @id @default(cuid())
  organizationId String
  moduleKey      String
  enabled        Boolean   @default(true)
  expiresAt      DateTime? // null = no expiry
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  module       Module       @relation(fields: [moduleKey], references: [key])

  @@unique([organizationId, moduleKey])
}

// ───────────── Recruitment ─────────────

enum JobStatus {
  DRAFT
  OPEN
  CLOSED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

model Job {
  id             String         @id @default(cuid())
  organizationId String
  title          String
  description    String
  department     String?
  location       String?
  employmentType EmploymentType @default(FULL_TIME)
  salaryMin      Int?
  salaryMax      Int?
  salaryCurrency String         @default("NGN")
  status         JobStatus      @default(DRAFT)
  createdAt      DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  applicants   Applicant[]

  @@index([organizationId, status])
}

// What a stage MEANS to the system. Names and order are per organization,
// but behaviour (e.g. "this is the hired stage") hangs off the kind.
enum StageKind {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
  CUSTOM
}

model PipelineStage {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  kind           StageKind @default(CUSTOM)
  position       Int

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  applicants   Applicant[]
  movesFrom    StageHistory[] @relation("FromStage")
  movesTo      StageHistory[] @relation("ToStage")

  @@unique([organizationId, position])
  @@index([organizationId])
}

enum ApplicantSource {
  APPLICATION_SITE
  MANUAL
}

model Applicant {
  id             String          @id @default(cuid())
  organizationId String
  jobId          String
  stageId        String
  name           String
  email          String
  phone          String?
  experience     String?
  portfolioUrl   String? @map("cvUrl") // LinkedIn / portfolio link given by the candidate
  cvPath         String? // storage pathname of the uploaded CV, never a public URL
  cvType         String? // validated content type (pdf or docx)
  cvText         String? // extracted text, used for screening
  consentAt      DateTime? // when the candidate agreed to data processing
  source         ApplicantSource @default(APPLICATION_SITE)
  aiScore        Int?
  aiSummary      String?
  notes          String          @default("")
  createdAt      DateTime        @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job          Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  stage        PipelineStage  @relation(fields: [stageId], references: [id])
  history      StageHistory[]
  emails       EmailLog[]

  @@unique([jobId, email])
  @@index([organizationId, stageId])
  @@index([organizationId, jobId])
}

// Audit trail: who moved which candidate, from where to where, and when
model StageHistory {
  id             String   @id @default(cuid())
  organizationId String
  applicantId    String
  fromStageId    String?
  toStageId      String
  changedById    String? // null when the system moved them (e.g. AI screening)
  createdAt      DateTime @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  applicant    Applicant      @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  fromStage    PipelineStage? @relation("FromStage", fields: [fromStageId], references: [id])
  toStage      PipelineStage  @relation("ToStage", fields: [toStageId], references: [id])
  changedBy    User?          @relation(fields: [changedById], references: [id])

  @@index([organizationId, applicantId])
}

model EmailLog {
  id             String   @id @default(cuid())
  organizationId String
  applicantId    String
  to             String
  subject        String
  body           String
  status         String   @default("SENT") // SENT | FAILED
  sentAt         DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  applicant    Applicant    @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@index([organizationId, applicantId])
}