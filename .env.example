# PostgreSQL (e.g. Supabase / Neon). Pooled URL for the app, direct URL for migrations.
DATABASE_URL="postgresql://user:password@localhost:5432/recruit?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/recruit?schema=public"

# Better Auth
BETTER_AUTH_SECRET="replace-with-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"

# Optional: real candidate emails through Resend. Leave blank in development —
# emails are then printed to the server console and logged as "LOGGED".
RESEND_API_KEY=""
EMAIL_FROM="Hiring Team <hiring@yourdomain.com>"
